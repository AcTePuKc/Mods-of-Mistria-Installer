<Project>
  <PropertyGroup>
    <!-- Single source of truth for GUI, CLI and release packaging. -->
    <Version>0.2.2</Version>
    <!-- The Nexus test package must not contact GitHub for update checks. -->
    <AimDistribution Condition="'$(AimDistribution)' == ''">GitHub</AimDistribution>
    <DefineConstants Condition="'$(AimDistribution)' == 'Nexus'">$(DefineConstants);AIM_NEXUS_DISTRIBUTION</DefineConstants>
    <!-- Windows assembly/file versions are numeric. The complete SemVer (including the
         prerelease suffix) is preserved in InformationalVersion and shown by AppInfo. -->
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
