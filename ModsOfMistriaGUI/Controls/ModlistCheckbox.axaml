<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:lang="clr-namespace:Garethp.ModsOfMistriaInstallerLib.Lang;assembly=ModsOfMistriaInstallerLib"
             xmlns:models="using:Garethp.ModsOfMistriaGUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Garethp.ModsOfMistriaGUI.Controls.ModlistCheckbox">
    <Design.DataContext>
        <models:ModModel />
    </Design.DataContext>
    <UserControl.Styles>
        <!-- The changelog icon is a button because it is clickable, but it should read as an icon
             sitting after the version - not as a control competing with the row. -->
        <Style Selector="Button.changelog">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4 0" />
            <Setter Property="Margin" Value="2 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.changelog:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.changelog:pointerover Image">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </UserControl.Styles>
    <Grid HorizontalAlignment="Stretch">
        <WrapPanel IsVisible="{Binding ShowPlainRow}">
                <CheckBox IsEnabled="{Binding !InError}"
                          IsChecked="{Binding Enabled}"
                          PointerPressed="ModCheckboxPressed"
                          Click="ModCheckboxClick">
                    <!-- Name and version as two blocks, so the version sits clear of the title
                         instead of running into it, and can be dimmed as secondary information. -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding InstalledVersion}" Opacity="0.65" />
                    </StackPanel>
                </CheckBox>
                <!-- The description lives behind an info icon rather than on the row itself, so
                     hovering a mod to read its name does not throw a wall of text at you. -->
                <Image Width="16" Height="16" Margin="5 0 0 0"
                       IsVisible="{Binding HasDescription}"
                       PointerEntered="OnDescriptionInfoPointerEntered"
                       PointerExited="OnDescriptionInfoPointerExited">
                    <Image.Source>
                        <i:IconImage Value="fa-solid fa-circle-info"
                                     Brush="Gray" />
                    </Image.Source>
                </Image>
                <!-- Release notes. Outside the CheckBox so clicking it opens the history rather
                     than toggling the mod, and hidden entirely for mods AIM cannot identify on
                     Nexus - an icon that can only say "nothing here" is worse than no icon. -->
                <Button Classes="changelog"
                        IsVisible="{Binding CanShowChangelog}"
                        Command="{Binding Commands.ShowChangelog}"
                        CommandParameter="{Binding}"
                        PointerEntered="ChangelogHovered">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding ChangelogPreview}"
                                   TextWrapping="Wrap"
                                   MaxWidth="560" />
                    </ToolTip.Tip>
                    <Image Height="14">
                        <Image.Source>
                            <i:IconImage Value="fa-file-lines" Brush="Gray" />
                        </Image.Source>
                    </Image>
                </Button>
                <Image Height="16" Margin="5 0 0 0"
                       IsVisible="{Binding InWarning}">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding WarningTooltip}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720" />
                    </ToolTip.Tip>
                    <Image.Source>
                        <i:IconImage Value="fa-exclamation-triangle"
                                     Brush="Orange" />
                    </Image.Source>
                </Image>
                <Image Height="16" Margin="5 0 0 0"
                       IsVisible="{Binding WasInstalled}">
                    <ToolTip.Tip>
                        <TextBlock Text="{Binding InstallStatusTooltip}" />
                    </ToolTip.Tip>
                    <Image.Source>
                        <i:IconImage Value="fa-circle-check"
                                     Brush="Green" />
                    </Image.Source>
                </Image>
        </WrapPanel>

        <Expander IsVisible="{Binding ShowStatusRow}"
                  HorizontalAlignment="Stretch"
                  Classes.failed="{Binding WasFailed}"
                  Classes.warning="{Binding InWarning}">
            <Expander.Styles>
                <Style Selector="Expander">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="{DynamicResource ModStatusBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ModStatusForegroundBrush}" />
                </Style>
                <Style Selector="Expander.failed">
                    <Setter Property="Background" Value="{DynamicResource ModFailureBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ModFailureForegroundBrush}" />
                </Style>
                <Style Selector="Expander ToggleButton">
                    <Style
                        Selector="^:pointerover /template/ Border#ToggleButtonBackground">
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>

                <Style Selector="Expander CheckBox">
                    <Setter Property="Foreground" Value="{DynamicResource ModStatusForegroundBrush}" />
                </Style>
            </Expander.Styles>
            <Expander.Header>
                <WrapPanel>
                    <CheckBox IsEnabled="{Binding !InError}"
                              IsChecked="{Binding Enabled}"
                              PointerPressed="ModCheckboxPressed"
                              Click="ModCheckboxClick">
                        <!-- Name and version as two blocks, so the version sits clear of the title
                             instead of running into it, and can be dimmed as secondary
                             information. -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding InstalledVersion}" Opacity="0.65" />
                        </StackPanel>
                    </CheckBox>
                    <Image Width="16" Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding HasDescription}"
                           PointerEntered="OnDescriptionInfoPointerEntered"
                           PointerExited="OnDescriptionInfoPointerExited">
                        <Image.Source>
                            <i:IconImage Value="fa-solid fa-circle-info"
                                         Brush="Gray" />
                        </Image.Source>
                    </Image>

                    <!-- Release notes; see the plain row above for why this sits outside the
                         CheckBox rather than inside its content. -->
                    <Button Classes="changelog"
                            IsVisible="{Binding CanShowChangelog}"
                            Command="{Binding Commands.ShowChangelog}"
                            CommandParameter="{Binding}"
                            PointerEntered="ChangelogHovered">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding ChangelogPreview}"
                                       TextWrapping="Wrap"
                                       MaxWidth="560" />
                        </ToolTip.Tip>
                        <Image Height="14">
                            <Image.Source>
                                <i:IconImage Value="fa-file-lines" Brush="Gray" />
                            </Image.Source>
                        </Image>
                    </Button>

                    <Image Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding InWarning}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding WarningTooltip}"
                                       TextWrapping="Wrap"
                                       MaxWidth="720" />
                        </ToolTip.Tip>
                        <Image.Source>
                            <i:IconImage Value="fa-exclamation-triangle"
                                         Brush="Orange" />
                        </Image.Source>
                    </Image>

                    <Image Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding ShowErrorIcon}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding Errors}"
                                       TextWrapping="Wrap"
                                       MaxWidth="720" />
                        </ToolTip.Tip>
                        <Image.Source>
                            <i:IconImage Value="fa-exclamation-triangle"
                                         Brush="OrangeRed" />
                        </Image.Source>
                    </Image>

                    <Image Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding WasSkipped}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding Texts.GUIModSkipped}" />
                        </ToolTip.Tip>
                        <Image.Source>
                            <i:IconImage Value="fa-circle-xmark"
                                         Brush="Red" />
                        </Image.Source>
                    </Image>

                    <Image Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding WasFailed}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding Texts.GUIInstallFailedForMod}" />
                        </ToolTip.Tip>
                        <Image.Source>
                            <i:IconImage Value="fa-circle-xmark"
                                         Brush="Red" />
                        </Image.Source>
                    </Image>

                    <Image Height="16" Margin="5 0 0 0"
                           IsVisible="{Binding WasInstalled}">
                        <ToolTip.Tip>
                            <TextBlock Text="{Binding InstallStatusTooltip}" />
                        </ToolTip.Tip>
                        <Image.Source>
                            <i:IconImage Value="fa-circle-check"
                                         Brush="Green" />
                        </Image.Source>
                    </Image>
                </WrapPanel>
            </Expander.Header>

            <StackPanel>
                <SelectableTextBlock TextWrapping="Wrap" IsVisible="{Binding ShowInstallDetail}"
                                     Text="{Binding InstallDetail}"
                                     Foreground="{DynamicResource ModStatusForegroundBrush}" />
                <SelectableTextBlock TextWrapping="Wrap" IsVisible="{Binding ShowErrorIcon}"
                                     Text="{Binding Errors}"
                                     Foreground="{DynamicResource ModStatusForegroundBrush}" />
                <SelectableTextBlock IsVisible="{Binding InWarning}" Text="{Binding WarningTooltip}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource ModStatusForegroundBrush}" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
