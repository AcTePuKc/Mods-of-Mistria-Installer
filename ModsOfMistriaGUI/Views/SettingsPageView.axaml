<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Garethp.ModsOfMistriaGUI.ViewModels"
             x:Class="Garethp.ModsOfMistriaGUI.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="4">
        <Button Content="← Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" />

        <Grid Grid.Row="1" ColumnDefinitions="170,*" Margin="0 12 0 0">
            <Border Grid.Column="0" Background="#202020" Padding="8" CornerRadius="4">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
            </Border>

            <Border Grid.Column="1" Margin="12 0 0 0" Padding="16" Background="#171717" CornerRadius="4">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel IsVisible="{Binding IsGeneralSelected}" Spacing="8">
                            <TextBlock Text="General" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Choose the game and mods folders used by AIM." TextWrapping="Wrap" />
                            <TextBlock Text="Game folder" FontWeight="Bold" />
                            <TextBox Text="{Binding Settings.MistriaLocation}" IsReadOnly="True" />
                            <TextBlock Text="Mods folder" FontWeight="Bold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Settings.ModsLocation, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Choose…" Margin="8 0 0 0" Command="{Binding SelectModsLocationCommand}" />
                            </Grid>
                            <TextBlock Text="The mods folder can be changed at any time; AIM will reload it when you return to the mod list." TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsNexusSelected}" Spacing="8">
                            <TextBlock Text="Nexus" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="AIM uses your personal Nexus API key for Nexus downloads and update checks. The key is stored locally and is never included in a mod or release package." TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Nexus.HasApiKey, StringFormat='API key status: {0}'}" />
                            <Button Content="Set or change Nexus API key…"
                                    Command="{Binding SetNexusApiKeyCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="The same key is used by the Nexus downloads menu in the Cog menu." TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
