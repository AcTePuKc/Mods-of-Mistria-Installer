<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Garethp.ModsOfMistriaGUI.ViewModels"
             x:Class="Garethp.ModsOfMistriaGUI.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="4">
        <Button Content="{Binding Texts.GUISettingsBack}" Command="{Binding BackCommand}" HorizontalAlignment="Left" />

        <Grid Grid.Row="1" ColumnDefinitions="170,*" Margin="0 12 0 0">
            <Border Grid.Column="0" Background="#202020" Padding="8" CornerRadius="4">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />
            </Border>

            <Border Grid.Column="1" Margin="12 0 0 0" Padding="16" Background="#171717" CornerRadius="4">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <StackPanel IsVisible="{Binding IsGeneralSelected}" Spacing="8">
                            <TextBlock Text="{Binding Texts.GUISettingsGeneral}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding Texts.GUISettingsGeneralDescription}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Texts.GUISettingsGameFolder}" FontWeight="Bold" />
                            <TextBox Text="{Binding Settings.MistriaLocation}" IsReadOnly="True" />
                            <TextBlock Text="{Binding Texts.GUISettingsModsFolder}" FontWeight="Bold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Settings.ModsLocation, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="{Binding Texts.GUISettingsChooseModsFolder}" Margin="8 0 0 0" Command="{Binding SelectModsLocationCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Texts.GUISettingsModsFolderNote}" TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsNexusSelected}" Spacing="8">
                            <TextBlock Text="{Binding Texts.GUISettingsNexus}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding Texts.GUISettingsNexusDescription}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NexusAccountStatus}" />
                            <Button Content="Nexus account..."
                                    Command="{Binding ManageNexusAccountCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Texts.GUISettingsNexusNote}" TextWrapping="Wrap" Foreground="Gray" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
