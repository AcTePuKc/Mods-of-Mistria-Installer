<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm="using:Garethp.ModsOfMistriaGUI.ViewModels"
        x:Class="Garethp.ModsOfMistriaGUI.Views.MainWindow"
        xmlns:lang="clr-namespace:Garethp.ModsOfMistriaInstallerLib.Lang;assembly=ModsOfMistriaInstallerLib"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/small_icon.png"
        Width="820" Height="600"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key='Light'>
                    <SolidColorBrush x:Key='IconColor'>Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key='Dark'>
                    <SolidColorBrush x:Key='IconColor'>White</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- The header row is proportional with a cap rather than a fixed 145: on a short window a
         fixed banner takes a third of the height away from the mod list, and the list is the
         window. The cap goes on the row, not on the image - capping only the image would let the
         row keep growing on a tall window and leave a widening empty band around the banner, which
         costs the list more height than the fixed 145 ever did. As it is, the banner is its usual
         145 on anything about 490 tall or more, and gives height back below that. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.42*" MinHeight="80" MaxHeight="145" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Source="/Assets/header.jpg" Stretch="UniformToFill" />

        <!-- 32 points of side margin is 64 points of a 480-wide window. The page inside wraps its
             own toolbars now, so it needs the width more than the whitespace. -->
        <Panel Grid.Row="1" Margin="16 12 16 0" ClipToBounds="True">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </Panel>

        <!-- An update is important, but it should not permanently take a row from the mod list. -->
        <Border Grid.Row="2"
                IsVisible="{Binding UpdateAvailable}"
                Background="#2D6B4A"
                CornerRadius="4"
                Padding="10 6"
                Margin="32 6 32 10"
                HorizontalAlignment="Right"
                MaxWidth="560">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding UpdateMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Texts.GUIGitHubButtonText}" Click="OpenGitHubClick" Margin="12 0 0 0" />
                    <Button Grid.Column="2"
                            Content="×"
                            Command="{Binding DismissUpdateCommand}"
                            FontSize="18"
                            Padding="6 0"
                            Margin="6 0 0 0" />
                </Grid>
        </Border>
    </Grid>
</Window>
