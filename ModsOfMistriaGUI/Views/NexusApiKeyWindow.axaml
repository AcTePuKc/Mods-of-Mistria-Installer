<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="320"
        x:Class="Garethp.ModsOfMistriaGUI.Views.NexusApiKeyWindow"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" />

        <Button x:Name="OpenAccountPageButton" HorizontalAlignment="Left" Click="OnOpenAccountPage" />

        <TextBox x:Name="ApiKeyBox"
                 PasswordChar="•"
                 AcceptsReturn="False"
                 KeyDown="OnKeyBoxKeyDown" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="Gray" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RemoveButton" Click="OnRemove" />
            <Button x:Name="CancelButton" Click="OnCancel" />
            <Button x:Name="SaveButton" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
