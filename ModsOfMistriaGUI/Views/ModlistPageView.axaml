<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Garethp.ModsOfMistriaGUI.Models"
             xmlns:lang="clr-namespace:Garethp.ModsOfMistriaInstallerLib.Lang;assembly=ModsOfMistriaInstallerLib"
             xmlns:controls="clr-namespace:Garethp.ModsOfMistriaGUI.Controls"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Garethp.ModsOfMistriaGUI.Views.ModlistPageView"
             d:DataContext="{x:Static models:DesignData.ModlistPageViewModel}">
    <DockPanel LastChildFill="True">

        <!-- Bottom toolbar: settings, language and actions share one compact row. -->
        <Grid DockPanel.Dock="Bottom" Height="44" Margin="0 8 0 0"
              ColumnDefinitions="Auto,Auto,*,Auto">
            <Menu Grid.Column="0" Margin="-7 0 0 0">
                <MenuItem>
                    <MenuItem.Header>
                        <Image Height="16" Margin="5 0 0 0">
                            <Image.Source>
                                <i:IconImage Value="fa-gear" Brush="{DynamicResource IconColor}" />
                            </Image.Source>
                        </Image>
                    </MenuItem.Header>
                    <MenuItem Header="Check for updates"
                              Command="{Binding CheckForUpdatesNowCommand}"
                              IsEnabled="{Binding !IsInstalling}"
                              ToolTip.Tip="Check for newer versions of the selected mod sources." />
                    <Separator />
                    <MenuItem Header="{Binding Texts.GUIReloadModlist}" Command="{Binding ReloadModlistCommand}" IsEnabled="{Binding !IsInstalling}" />
                    <MenuItem Header="{Binding Texts.GUISaveLogFile}" Command="{Binding SaveLogFileCommand}" />
                    <MenuItem Header="{Binding Texts.GUIEnableAllMods}" Command="{Binding EnableAllModsCommand}" IsEnabled="{Binding !IsInstalling}" />
                    <MenuItem Header="{Binding Texts.GUIDisableAllMods}" Command="{Binding DisableAllModsCommand}" IsEnabled="{Binding !IsInstalling}" />
                    <Separator />
                    <MenuItem Header="Settings…" Click="SettingsMenuClick" IsEnabled="{Binding !IsInstalling}" />
                    <Separator />
                    <MenuItem Header="{Binding Texts.GUILaunchGameDirectly}"
                              ToggleType="CheckBox"
                              IsChecked="{Binding LaunchGameDirectly, Mode=TwoWay}" />
                    <Separator />
                    <!-- Nexus "Mod Manager Download" support -->
                    <MenuItem Header="{Binding Texts.GUINexusMenu}">
                        <MenuItem Header="{Binding Texts.GUINexusHandlerMenuItem}"
                                  Command="{Binding Nexus.ToggleHandlerCommand}" />
                        <MenuItem Header="{Binding Nexus.HandlerStatus}" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="{Binding Texts.GUINexusApiKeyMenuItem}"
                                  Command="{Binding Nexus.SetApiKeyCommand}" />
                        <MenuItem Header="{Binding Texts.GUINexusPasteLinkMenuItem}"
                                  Command="{Binding Nexus.PasteLinkCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Texts.GUICheckSelectedForUpdates}"
                                  Command="{Binding CheckSelectedModsForUpdatesCommand}"
                                  IsEnabled="{Binding !IsInstalling}" />
                        <MenuItem Header="{Binding Texts.GUICheckAllForUpdates}"
                                  Command="{Binding CheckAllModsForUpdatesCommand}"
                                  IsEnabled="{Binding !IsInstalling}" />
                    </MenuItem>
                </MenuItem>
            </Menu>

            <Menu Grid.Column="1" Margin="-1 0 0 0">
                <MenuItem Header="{Binding Texts.GUILanguageMenu}"
                          IsEnabled="{Binding !IsInstalling}">
                    <MenuItem x:Name="LanguageSystemMenuItem" Header="{Binding Texts.GUILanguageSystem}" Tag="system" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageEnglishMenuItem" Header="{Binding Texts.GUILanguageEnglish}" Tag="en" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageBulgarianMenuItem" Header="{Binding Texts.GUILanguageBulgarian}" Tag="bg" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguagePolishMenuItem" Header="{Binding Texts.GUILanguagePolish}" Tag="pl" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageGermanMenuItem" Header="{Binding Texts.GUILanguageGerman}" Tag="de" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageFrenchMenuItem" Header="{Binding Texts.GUILanguageFrench}" Tag="fr" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageDutchMenuItem" Header="{Binding Texts.GUILanguageDutch}" Tag="nl" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguagePortugueseMenuItem" Header="{Binding Texts.GUILanguagePortugueseBrazil}" Tag="pt-br" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageRussianMenuItem" Header="{Binding Texts.GUILanguageRussian}" Tag="ru" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageIndonesianMenuItem" Header="{Binding Texts.GUILanguageIndonesian}" Tag="id" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageSimplifiedChineseMenuItem" Header="{Binding Texts.GUILanguageSimplifiedChinese}" Tag="zh-hans" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageTraditionalChineseMenuItem" Header="{Binding Texts.GUILanguageTraditionalChinese}" Tag="zh-hant" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageKoreanMenuItem" Header="{Binding Texts.GUILanguageKorean}" Tag="ko" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageJapaneseMenuItem" Header="{Binding Texts.GUILanguageJapanese}" Tag="ja" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageSpanishMenuItem" Header="{Binding Texts.GUILanguageSpanish}" Tag="es" Click="LanguageMenuClick" />
                    <MenuItem x:Name="LanguageUkrainianMenuItem" Header="{Binding Texts.GUILanguageUkrainian}" Tag="uk" Click="LanguageMenuClick" />
                </MenuItem>
            </Menu>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding InstallStatus}"
                       TextTrimming="CharacterEllipsis"
                       Margin="12 0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button
                        Command="{Binding LaunchGameCommand}"
                        Content="{Binding Texts.GUIPlayButtonText}" />
                <Button Command="{Binding InstallModsCommand}"
                        Content="{Binding InstallButtonText}" />
                <Button Command="{Binding UnInstallModsCommand}"
                        Content="{Binding Texts.GUIUninstallButtonText}" />
            </StackPanel>
        </Grid>

        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <!-- Greeting / location info -->
                <WrapPanel>
                    <TextBlock Margin="0 0 5 0"
                               Text="{Binding Texts.GUIFieldsOfMistriaDetectedLocation}" />
                    <TextBlock Text="{Binding MistriaLocation}" />
                </WrapPanel>
                <TextBlock Text="{Binding ModsWillBeInstalledText}" />
                <TextBlock Text="{Binding ArchiveStatus}"
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0 4 0 0" />

                <!-- Profile selector -->
                <WrapPanel Margin="0 8 0 0" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0 0 6 0" Text="{Binding Texts.GUIProfileLabel}" />
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding CurrentProfile, Mode=OneWay}"
                              MinWidth="140"
                              SelectionChanged="OnProfileSelectionChanged" />
                    <Button Margin="6 0 0 0" ToolTip.Tip="{Binding Texts.GUINewProfile}"
                            Command="{Binding CreateProfileCommand}">+</Button>
                    <Button Margin="4 0 0 0" ToolTip.Tip="{Binding Texts.GUIDeleteCurrentProfile}"
                            Command="{Binding DeleteCurrentProfileCommand}">-</Button>
                </WrapPanel>
                <!-- Nexus downloads in progress. Hidden entirely when nothing is
                     downloading so the page looks exactly as it did before. -->
                <Border IsVisible="{Binding Nexus.HasDownloads, FallbackValue=False, TargetNullValue=False}"
                        Margin="0 10 0 0"
                        Padding="10 8"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="Gray">
                    <StackPanel Spacing="6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Padding="6 1"
                                    Content="{Binding Texts.GUINexusClearFinished}"
                                    Command="{Binding Nexus.ClearFinishedDownloadsCommand}" />
                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="{Binding Texts.GUINexusDownloadsHeader}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Nexus.Downloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Height="6"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Progress}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         IsVisible="{Binding !IsFinished}" />
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="Gray" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Margin="8 0 0 0"
                                                Padding="6 1"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanCancel}"
                                                Command="{Binding CancelCommand}"
                                                Content="&#x2715;" />
                                        <Button Grid.Column="1"
                                                Margin="8 0 0 0"
                                                Padding="6 1"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsFinished}"
                                                Command="{Binding $parent[ItemsControl].DataContext.Nexus.DismissDownloadCommand}"
                                                CommandParameter="{Binding}"
                                                Content="&#x2715;" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- List header: select everything at once, see what the selection means, and ask
                     for a load order that satisfies the mods' declared requirements. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 12 0 2">
                    <CheckBox Grid.Column="0"
                              Margin="0 0 4 0"
                              IsThreeState="True"
                              IsChecked="{Binding AllModsSelected, Mode=OneWay}"
                              IsEnabled="{Binding CanChangeModSelection}"
                              Command="{Binding ToggleAllModsCommand}"
                              ToolTip.Tip="{Binding Texts.GUIToggleAllMods}" />

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectionSummary}" />

                    <Button Grid.Column="2"
                            Padding="8 2"
                            Content="{Binding Texts.GUISuggestLoadOrder}"
                            ToolTip.Tip="{Binding Texts.GUISuggestLoadOrderTooltip}"
                            Command="{Binding SuggestLoadOrderCommand}" />
                </Grid>
            </StackPanel>

            <!-- Mod list. The recoverable error is an overlay so it does not
                 reduce the list viewport or move the normal page content. -->
            <Grid>
                <ScrollViewer Margin="0 5 0 0">
                    <ItemsRepeater ItemsSource="{Binding Mods}" x:Name="ModRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="22,24,*,Auto"
                                      Classes="mod-row"
                                      Classes.alt="{Binding IsAlternateRow}"
                                      Background="Transparent"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="OnModRowDragOver"
                                      DragDrop.DragLeave="OnModRowDragLeave"
                                      DragDrop.Drop="OnModRowDrop"
                                      Margin="0 2 0 2">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="{Binding Texts.GUIOpenNexusPage}"
                                                      IsEnabled="{Binding IsFromNexus}"
                                                      Command="{Binding Commands.OpenNexusPage}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding Texts.GUICheckForUpdate}"
                                                      Command="{Binding Commands.CheckForUpdate}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding Texts.GUIUpdateFromNexus}"
                                                      IsEnabled="{Binding CanUpdateFromNexus}"
                                                      Command="{Binding Commands.UpdateFromNexus}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{Binding FreezeMenuHeader}"
                                                      Command="{Binding Commands.ToggleFreeze}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding Texts.GUIRestorePreviousVersion}"
                                                      IsEnabled="{Binding HasBackup}"
                                                      Command="{Binding Commands.RestorePreviousVersion}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{Binding Texts.GUIOpenModFolder}"
                                                      Command="{Binding Commands.OpenModFolder}"
                                                      CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.Styles>
                                        <Style Selector="Grid.alt">
                                            <Setter Property="Background" Value="{DynamicResource ModAlternateRowBrush}" />
                                        </Style>
                                        <Style Selector="Grid.dragging">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Style>
                                    </Grid.Styles>
                                    <!-- Drag the grip to change load order. Keeping this separate from
                                         the checkbox prevents a reorder gesture from toggling a mod. -->
                                    <Border Grid.Column="0"
                                            Width="22"
                                            Margin="0 0 4 0"
                                            VerticalAlignment="Stretch"
                                            Cursor="SizeAll"
                                            IsEnabled="{Binding $parent[ItemsRepeater].DataContext.CanReorderMods}"
                                            PointerPressed="OnModDragGripPointerPressed">
                                        <TextBlock Text="⠿"
                                                   FontSize="16"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="-7 0 0 0" />
                                    </Border>
                                    <!-- Position number -->
                                    <TextBlock Width="24" Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Position}"
                                               HorizontalAlignment="Right"
                                               Margin="0 0 6 0"
                                               Foreground="Gray" />
                                    <!-- Mod checkbox + warnings -->
                                    <controls:ModlistCheckbox Grid.Column="2"
                                                              HorizontalAlignment="Stretch"
                                                              IsEnabled="{Binding $parent[ItemsRepeater].DataContext.CanChangeModSelection}"
                                                              DataContext="{Binding}" />
                                    <!-- Row-trailing badges. They share column 3, so they sit in a
                                         stack rather than on top of each other. -->
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                        <!-- Frozen: this mod is deliberately held at its current version -->
                                        <TextBlock Text="&#x1F512;"
                                                   IsVisible="{Binding IsFrozen}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding Texts.GUIModFrozenTooltip}" />
                                        <!-- Update available badge -->
                                        <Button IsVisible="{Binding UpdateAvailable}"
                                                Command="{Binding OpenUpdateUrlCommand}"
                                                Padding="5 1"
                                                Background="#2e7d32"
                                                Foreground="White"
                                                CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Content="{Binding Texts.GUIUpdateMod}"
                                                ToolTip.Tip="{Binding UpdateTooltip}" />
                                    </StackPanel>
                                    <!-- The active line makes the exact insertion point obvious while dragging. -->
                                    <Border x:Name="DropBeforeIndicator"
                                            Grid.ColumnSpan="4"
                                            Height="3"
                                            VerticalAlignment="Top"
                                            Background="#58D1B2"
                                            IsHitTestVisible="False"
                                            IsVisible="False" />
                                    <Border x:Name="DropAfterIndicator"
                                            Grid.ColumnSpan="4"
                                            Height="3"
                                            VerticalAlignment="Bottom"
                                            Background="#58D1B2"
                                            IsHitTestVisible="False"
                                            IsVisible="False" />
                                    <!-- Briefly confirms the row that accepted the drop. -->
                                    <Border x:Name="DropCompleteFlash"
                                            Grid.ColumnSpan="4"
                                            Background="#8058D1B2"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                            </Transitions>
                                        </Border.Transitions>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Recoverable install error: keep the mod list available so
                     the user can disable the failing mod and retry. -->
                <Border IsVisible="{Binding Exception.Length}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        MaxHeight="92"
                        Margin="15 5 0 0"
                        Background="#5C1F1F"
                        CornerRadius="4"
                        Padding="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0" MaxHeight="76">
                            <SelectableTextBlock Text="{Binding Exception}"
                                                 TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Content="×"
                                FontSize="18"
                                Padding="8 0"
                                VerticalAlignment="Top"
                                ToolTip.Tip="Close"
                                Command="{Binding DismissExceptionCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
